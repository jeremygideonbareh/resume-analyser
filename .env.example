# ResumeLab environment variables
# Copy to `.env.local` to override defaults. NEVER commit real secrets.

# --- Client (Vite) ---
# Enables the optional "AI Feedback" LLM tier. Default OFF — when off,
# the AI section is hidden and no API call is bundled or made.
VITE_ENABLE_LLM=false

# --- Server (api/analyze.ts — set in the HOST's env store, never client) ---
# API key for the LLM provider. Required when VITE_ENABLE_LLM=true.
# LLM_API_KEY=sk-...

# Model name (any OpenAI-compatible chat-completions model).
# LLM_MODEL=gpt-4o-mini

# OpenAI-compatible base URL.
# LLM_BASE_URL=https://api.openai.com/v1

# Upstream call timeout in milliseconds (default 10000).
# LLM_TIMEOUT_MS=10000
