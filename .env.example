# ResumeLab environment variables
# Copy to `.env.local` to override defaults. NEVER commit real secrets.

# --- Client (Vite) ---
# Enables the optional "AI Feedback" LLM tier. Default OFF — when off,
# the AI section is hidden and no API call is bundled or made.
VITE_ENABLE_LLM=false

# --- Server (api/analyze.ts — set in the HOST's env store, never client) ---
# API key for the LLM provider. Required when VITE_ENABLE_LLM=true.
# LLM_API_KEY=sk-...

# Model name (any OpenAI-compatible chat-completions model).
# LLM_MODEL=gpt-4o-mini

# OpenAI-compatible base URL.
# LLM_BASE_URL=https://api.openai.com/v1

# Upstream call timeout in milliseconds (default 10000).
# LLM_TIMEOUT_MS=10000

# --- Supabase Auth + per-user history (Wave 2/3) ---
# Client-safe (public) — required for sign-in and the personal dashboard.
# Get both from Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Provisioning only (Management API) — used ONCE by the migration script
# (.omo/scripts/migrate-resume-analyses.mjs) to create the `resume_analyses`
# table + RLS. NEVER used in client code; NEVER committed. Rotate after setup.
# SUPABASE_PAT=sbp_...

# --- Supabase server-side (used by api/ endpoints) ---
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Vercel deploy token ---
# Used by `npm run secrets:sync` to push env vars to Vercel's runtime store.
# Also needed for `vercel --prod` deploys via CLI. Get from:
# Vercel Dashboard → Account Settings → Tokens.
# VERCEL_TOKEN=vcp_...
